.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# --- Source data (synthetic, but contains CPF/e-mail-like fields; keep it out of a public repo) ---
data/
*.csv

# --- Personal working notes (not part of the deliverable) ---
DECISIONS.md

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- Airflow / Meltano local artifacts ---
logs/
.meltano/
meltano.db

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
