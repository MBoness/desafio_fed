locals {
  warehouse_name        = "warehouse"
  warehouse_secret_name = "warehouse-credentials"
  warehouse_db          = "banvic"
  warehouse_user        = "banvic"

  # One schema per data layer (see DECISIONS.md, D3).
  warehouse_schemas = ["raw", "standard", "curated"]
}

# --- Credentials ------------------------------------------------------------
# Generated by Terraform and stored only as a Kubernetes Secret (plus the local,
# git-ignored state). The key names are the ones the official Postgres image reads.
resource "random_password" "warehouse" {
  length  = 24
  special = false
}

resource "kubernetes_secret_v1" "warehouse_credentials" {
  metadata {
    name      = local.warehouse_secret_name
    namespace = kubernetes_namespace_v1.airflow.metadata[0].name
    labels    = local.common_labels
  }

  data = {
    POSTGRES_DB       = local.warehouse_db
    POSTGRES_USER     = local.warehouse_user
    POSTGRES_PASSWORD = random_password.warehouse.result
  }
}

# --- Schemas ----------------------------------------------------------------
# The official image runs every .sql file in /docker-entrypoint-initdb.d the first
# time the database is created, so the layers exist as soon as Postgres is up.
resource "kubernetes_config_map_v1" "warehouse_init" {
  metadata {
    name      = "${local.warehouse_name}-init"
    namespace = kubernetes_namespace_v1.airflow.metadata[0].name
    labels    = local.common_labels
  }

  data = {
    "01-schemas.sql" = join("\n", [for s in local.warehouse_schemas : "CREATE SCHEMA IF NOT EXISTS ${s};"])
  }
}

# --- Postgres ---------------------------------------------------------------
# Data warehouse of the pipeline. Separate from the Airflow metadata database on
# purpose: orchestration state and business data have different lifecycles.
resource "kubernetes_stateful_set_v1" "warehouse" {
  metadata {
    name      = local.warehouse_name
    namespace = kubernetes_namespace_v1.airflow.metadata[0].name
    labels    = local.common_labels
  }

  spec {
    service_name = local.warehouse_name
    replicas     = 1

    selector {
      match_labels = { app = local.warehouse_name }
    }

    template {
      metadata {
        labels = { app = local.warehouse_name }
      }

      spec {
        container {
          name  = "postgres"
          image = var.warehouse_image

          port {
            container_port = 5432
          }

          env_from {
            secret_ref {
              name = kubernetes_secret_v1.warehouse_credentials.metadata[0].name
            }
          }

          # Postgres refuses to initialise a directory that is a volume root
          # (it contains lost+found), so the data goes into a sub-directory.
          env {
            name  = "PGDATA"
            value = "/var/lib/postgresql/data/pgdata"
          }

          volume_mount {
            name       = "data"
            mount_path = "/var/lib/postgresql/data"
          }

          volume_mount {
            name       = "init"
            mount_path = "/docker-entrypoint-initdb.d"
            read_only  = true
          }

          readiness_probe {
            exec {
              command = ["sh", "-c", "pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""]
            }
            initial_delay_seconds = 5
            period_seconds        = 5
          }

          resources {
            requests = {
              cpu    = "100m"
              memory = "128Mi"
            }
          }
        }

        volume {
          name = "init"
          config_map {
            name = kubernetes_config_map_v1.warehouse_init.metadata[0].name
          }
        }
      }
    }

    volume_claim_template {
      metadata {
        name = "data"
      }
      spec {
        access_modes = ["ReadWriteOnce"]
        resources {
          requests = { storage = "2Gi" }
        }
      }
    }
  }
}

# Stable in-cluster address: Meltano and Airflow reach it at warehouse:5432.
resource "kubernetes_service_v1" "warehouse" {
  metadata {
    name      = local.warehouse_name
    namespace = kubernetes_namespace_v1.airflow.metadata[0].name
    labels    = local.common_labels
  }

  spec {
    selector = { app = local.warehouse_name }

    port {
      port        = 5432
      target_port = 5432
    }
  }
}
