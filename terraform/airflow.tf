locals {
  # Where the CSV landing folder appears inside the Airflow containers.
  source_files_mount_path = "/opt/airflow/source"

  fernet_secret_name = "airflow-fernet-key"
  api_secret_name    = "airflow-api-secret-key"
  jwt_secret_name    = "airflow-jwt-secret"
}

# --- Airflow keys -----------------------------------------------------------
# Generated by Terraform and stored only as Kubernetes Secrets (plus the local,
# git-ignored state). Creating them here, instead of letting the chart do it,
# keeps them stable across `helm upgrade` runs.

# Fernet key: 32 random bytes in URL-safe base64, the format Airflow requires.
resource "random_bytes" "fernet" {
  length = 32
}

resource "random_password" "api_secret" {
  length  = 64
  special = false
}

resource "random_password" "jwt_secret" {
  length  = 64
  special = false
}

resource "kubernetes_secret_v1" "fernet" {
  metadata {
    name      = local.fernet_secret_name
    namespace = kubernetes_namespace_v1.airflow.metadata[0].name
    labels    = local.common_labels
  }

  data = {
    "fernet-key" = replace(replace(random_bytes.fernet.base64, "+", "-"), "/", "_")
  }
}

resource "kubernetes_secret_v1" "api_secret" {
  metadata {
    name      = local.api_secret_name
    namespace = kubernetes_namespace_v1.airflow.metadata[0].name
    labels    = local.common_labels
  }

  data = {
    "api-secret-key" = random_password.api_secret.result
  }
}

resource "kubernetes_secret_v1" "jwt_secret" {
  metadata {
    name      = local.jwt_secret_name
    namespace = kubernetes_namespace_v1.airflow.metadata[0].name
    labels    = local.common_labels
  }

  data = {
    "jwt-secret" = random_password.jwt_secret.result
  }
}

# --- Airflow ----------------------------------------------------------------
resource "helm_release" "airflow" {
  name       = "airflow"
  namespace  = kubernetes_namespace_v1.airflow.metadata[0].name
  repository = "https://airflow.apache.org"
  chart      = "airflow"
  version    = var.airflow_chart_version

  # First start runs database migrations and creates the admin user,
  # which takes a few minutes on a small local cluster.
  timeout = 900

  values = [yamlencode({
    # Tasks run inside the scheduler: no Celery workers or Redis to run and explain.
    executor = "LocalExecutor"

    fernetKeySecretName    = local.fernet_secret_name
    apiSecretKeySecretName = local.api_secret_name
    jwtSecretName          = local.jwt_secret_name

    # The migration and create-user jobs are Helm "post-install hooks" by default,
    # which Helm only runs after every pod is ready. The pods wait for the
    # migration, so with `wait = true` (Terraform's default) both wait forever.
    # Without hooks the jobs are plain resources created with everything else.
    migrateDatabaseJob = { useHelmHooks = false }
    createUserJob      = { useHelmHooks = false }

    # Not needed with LocalExecutor / for this project; saves memory.
    redis  = { enabled = false }
    statsd = { enabled = false }

    # Source CSV files, mounted read-only into every Airflow container.
    volumes = [{
      name                  = "source-files"
      persistentVolumeClaim = { claimName = kubernetes_persistent_volume_claim_v1.source_files.metadata[0].name }
    }]
    volumeMounts = [{
      name      = "source-files"
      mountPath = local.source_files_mount_path
      readOnly  = true
    }]
  })]

  # The chart only accepts the admin password as a plain value (no Secret option).
  # Passing it as a sensitive value keeps it out of plan output and out of git.
  set_sensitive {
    name  = "createUserJob.defaultUser.password"
    value = var.airflow_admin_password
  }

  depends_on = [
    kubernetes_secret_v1.fernet,
    kubernetes_secret_v1.api_secret,
    kubernetes_secret_v1.jwt_secret,
  ]
}
